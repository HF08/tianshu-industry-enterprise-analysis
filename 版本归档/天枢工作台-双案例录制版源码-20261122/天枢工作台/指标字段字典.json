{
  "FIN": {
    "formulas": [
      {
        "name": "营业收入",
        "unit": "元",
        "formula": "收入",
        "fields": [
          "收入"
        ]
      },
      {
        "name": "归母净利润",
        "unit": "元",
        "formula": "归母利润",
        "fields": [
          "归母利润"
        ]
      },
      {
        "name": "经营现金流",
        "unit": "元",
        "formula": "经营净现金",
        "fields": [
          "经营净现金"
        ]
      },
      {
        "name": "营业收入同比",
        "unit": "%",
        "formula": "(收入/前收入-1)*100",
        "fields": [
          "收入",
          "前收入"
        ]
      },
      {
        "name": "收入三年复合增速",
        "unit": "%",
        "formula": "(Math.pow(收入/三年前收入,1/3)-1)*100",
        "fields": [
          "收入",
          "三年前收入"
        ]
      },
      {
        "name": "产品收入占比",
        "unit": "%",
        "formula": "分部收入/收入*100",
        "fields": [
          "分部收入",
          "收入"
        ]
      },
      {
        "name": "分部收入增速",
        "unit": "%",
        "formula": "(分部收入/前分部收入-1)*100",
        "fields": [
          "分部收入",
          "前分部收入"
        ]
      },
      {
        "name": "前五大客户收入占比",
        "unit": "%",
        "formula": "前五客户销售额/收入*100",
        "fields": [
          "前五客户销售额",
          "收入"
        ]
      },
      {
        "name": "合同负债占收入",
        "unit": "%",
        "formula": "合同负债/收入*100",
        "fields": [
          "合同负债",
          "收入"
        ]
      },
      {
        "name": "应收占收入",
        "unit": "%",
        "formula": "应收账款/收入*100",
        "fields": [
          "应收账款",
          "收入"
        ]
      },
      {
        "name": "应收及合同资产占收入",
        "unit": "%",
        "formula": "(应收账款+合同资产)/收入*100",
        "fields": [
          "应收账款",
          "合同资产",
          "收入"
        ]
      },
      {
        "name": "销售费用率",
        "unit": "%",
        "formula": "销售费用/收入*100",
        "fields": [
          "销售费用",
          "收入"
        ]
      },
      {
        "name": "分部毛利率",
        "unit": "%",
        "formula": "(分部收入-分部成本)/分部收入*100",
        "fields": [
          "分部收入",
          "分部成本"
        ]
      },
      {
        "name": "分部营业利润率",
        "unit": "%",
        "formula": "分部营业利润/分部收入*100",
        "fields": [
          "分部营业利润",
          "分部收入"
        ]
      },
      {
        "name": "收现比",
        "unit": "倍",
        "formula": "销售收现/收入",
        "fields": [
          "销售收现",
          "收入"
        ]
      },
      {
        "name": "毛利率",
        "unit": "%",
        "formula": "(收入-营业成本)/收入*100",
        "fields": [
          "收入",
          "营业成本"
        ]
      },
      {
        "name": "营业利润率",
        "unit": "%",
        "formula": "营业利润/收入*100",
        "fields": [
          "营业利润",
          "收入"
        ]
      },
      {
        "name": "净利率",
        "unit": "%",
        "formula": "净利润/收入*100",
        "fields": [
          "净利润",
          "收入"
        ]
      },
      {
        "name": "管理费用率",
        "unit": "%",
        "formula": "管理费用/收入*100",
        "fields": [
          "管理费用",
          "收入"
        ]
      },
      {
        "name": "研发费用率",
        "unit": "%",
        "formula": "研发费用/收入*100",
        "fields": [
          "研发费用",
          "收入"
        ]
      },
      {
        "name": "增量营业利润率",
        "unit": "%",
        "formula": "(营业利润-前营业利润)/(收入-前收入)*100",
        "fields": [
          "营业利润",
          "前营业利润",
          "收入",
          "前收入"
        ]
      },
      {
        "name": "ROE（平均归母权益）",
        "unit": "%",
        "formula": "归母利润/((归母权益+前归母权益)/2)*100",
        "fields": [
          "归母利润",
          "归母权益",
          "前归母权益"
        ]
      },
      {
        "name": "资产周转率",
        "unit": "次",
        "formula": "收入/((总资产+前总资产)/2)",
        "fields": [
          "收入",
          "总资产",
          "前总资产"
        ]
      },
      {
        "name": "杜邦归母净利率",
        "unit": "%",
        "formula": "归母利润/收入*100",
        "fields": [
          "归母利润",
          "收入"
        ]
      },
      {
        "name": "杜邦权益乘数",
        "unit": "倍",
        "formula": "(总资产+前总资产)/(归母权益+前归母权益)",
        "fields": [
          "总资产",
          "前总资产",
          "归母权益",
          "前归母权益"
        ]
      },
      {
        "name": "ROIC",
        "unit": "%",
        "formula": "税后经营利润/((投入资本+前投入资本)/2)*100",
        "fields": [
          "税后经营利润",
          "投入资本",
          "前投入资本"
        ]
      },
      {
        "name": "增量ROIC",
        "unit": "%",
        "formula": "(税后经营利润-前税后经营利润)/(投入资本-前投入资本)*100",
        "fields": [
          "税后经营利润",
          "前税后经营利润",
          "投入资本",
          "前投入资本"
        ]
      },
      {
        "name": "资本开支占收入",
        "unit": "%",
        "formula": "资本开支/收入*100",
        "fields": [
          "资本开支",
          "收入"
        ]
      },
      {
        "name": "再投资率",
        "unit": "%",
        "formula": "(资本开支-折旧摊销+经营营运资本-前经营营运资本)/税后经营利润*100",
        "fields": [
          "资本开支",
          "折旧摊销",
          "经营营运资本",
          "前经营营运资本",
          "税后经营利润"
        ]
      },
      {
        "name": "经营现金流与净利润比",
        "unit": "倍",
        "formula": "经营净现金/净利润",
        "fields": [
          "经营净现金",
          "净利润"
        ]
      },
      {
        "name": "自由现金流",
        "unit": "元",
        "formula": "经营净现金-资本开支",
        "fields": [
          "经营净现金",
          "资本开支"
        ]
      },
      {
        "name": "DSO",
        "unit": "天",
        "formula": "(应收账款+前应收账款)/2/收入*年度天数",
        "fields": [
          "应收账款",
          "前应收账款",
          "收入",
          "年度天数"
        ]
      },
      {
        "name": "DIO",
        "unit": "天",
        "formula": "(存货+前存货)/2/营业成本*年度天数",
        "fields": [
          "存货",
          "前存货",
          "营业成本",
          "年度天数"
        ]
      },
      {
        "name": "DPO（成本代理）",
        "unit": "天",
        "formula": "(应付账款+前应付账款)/2/营业成本*年度天数",
        "fields": [
          "应付账款",
          "前应付账款",
          "营业成本",
          "年度天数"
        ]
      },
      {
        "name": "CCC",
        "unit": "天",
        "formula": "((应收账款+前应收账款)/收入+(存货+前存货-应付账款-前应付账款)/营业成本)*年度天数/2",
        "fields": [
          "应收账款",
          "前应收账款",
          "收入",
          "存货",
          "前存货",
          "应付账款",
          "前应付账款",
          "营业成本",
          "年度天数"
        ]
      },
      {
        "name": "经营净营运资本占收入",
        "unit": "%",
        "formula": "经营营运资本/收入*100",
        "fields": [
          "经营营运资本",
          "收入"
        ]
      },
      {
        "name": "资产负债率",
        "unit": "%",
        "formula": "总负债/总资产*100",
        "fields": [
          "总负债",
          "总资产"
        ]
      },
      {
        "name": "有息负债率",
        "unit": "%",
        "formula": "有息负债/总资产*100",
        "fields": [
          "有息负债",
          "总资产"
        ]
      },
      {
        "name": "净负债与EBITDA比",
        "unit": "倍",
        "formula": "(有息负债-现金等价物)/息税折旧摊销前利润",
        "fields": [
          "有息负债",
          "现金等价物",
          "息税折旧摊销前利润"
        ]
      },
      {
        "name": "利息保障倍数",
        "unit": "倍",
        "formula": "(税前利润+利息费用)/利息费用",
        "fields": [
          "税前利润",
          "利息费用"
        ]
      },
      {
        "name": "流动比率",
        "unit": "倍",
        "formula": "流动资产/流动负债",
        "fields": [
          "流动资产",
          "流动负债"
        ]
      },
      {
        "name": "速动比率（扣存货）",
        "unit": "倍",
        "formula": "(流动资产-存货)/流动负债",
        "fields": [
          "流动资产",
          "存货",
          "流动负债"
        ]
      },
      {
        "name": "短债占比",
        "unit": "%",
        "formula": "一年内到期有息债务/有息负债*100",
        "fields": [
          "一年内到期有息债务",
          "有息负债"
        ]
      },
      {
        "name": "经营现金流付息倍数",
        "unit": "倍",
        "formula": "经营净现金/利息费用",
        "fields": [
          "经营净现金",
          "利息费用"
        ]
      },
      {
        "name": "应计比率",
        "unit": "%",
        "formula": "(净利润-经营净现金)/((总资产+前总资产)/2)*100",
        "fields": [
          "净利润",
          "经营净现金",
          "总资产",
          "前总资产"
        ]
      },
      {
        "name": "非经常损益占归母利润",
        "unit": "%",
        "formula": "(归母利润-扣非归母)/归母利润*100",
        "fields": [
          "归母利润",
          "扣非归母"
        ]
      },
      {
        "name": "研发资本化率",
        "unit": "%",
        "formula": "资本化研发投入/研发总投入*100",
        "fields": [
          "资本化研发投入",
          "研发总投入"
        ]
      },
      {
        "name": "商誉占净资产",
        "unit": "%",
        "formula": "商誉/净资产*100",
        "fields": [
          "商誉",
          "净资产"
        ]
      },
      {
        "name": "销量同比",
        "unit": "%",
        "formula": "(销量/前销量-1)*100",
        "fields": [
          "销量",
          "前销量"
        ]
      },
      {
        "name": "产品平均售价",
        "unit": "元/件",
        "formula": "产品销售收入/销量",
        "fields": [
          "产品销售收入",
          "销量"
        ]
      },
      {
        "name": "量变贡献（上期价格）",
        "unit": "元",
        "formula": "(销量-前销量)*前产品销售收入/前销量",
        "fields": [
          "销量",
          "前销量",
          "前产品销售收入"
        ]
      },
      {
        "name": "价变贡献（本期销量）",
        "unit": "元",
        "formula": "产品销售收入-销量*前产品销售收入/前销量",
        "fields": [
          "产品销售收入",
          "销量",
          "前产品销售收入",
          "前销量"
        ]
      },
      {
        "name": "产品结构占比",
        "unit": "%",
        "formula": "产品销售收入/收入*100",
        "fields": [
          "产品销售收入",
          "收入"
        ]
      },
      {
        "name": "指引完成率",
        "unit": "%",
        "formula": "同口径实际值/原指引目标*100",
        "fields": [
          "同口径实际值",
          "原指引目标"
        ]
      }
    ],
    "disclosures": [
      "销量",
      "产品价格",
      "产品销售成本",
      "在手订单",
      "交付量",
      "合同负债",

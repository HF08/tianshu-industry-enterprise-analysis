  "SaaS与互联网": {
    "formulas": [
      {
        "name": "月经常性收入",
        "unit": "元/月",
        "formula": "月订阅收入",
        "fields": [
          "月订阅收入"
        ]
      },
      {
        "name": "年化经常性收入",
        "unit": "元/年",
        "formula": "月订阅收入*12",
        "fields": [
          "月订阅收入"
        ]
      },
      {
        "name": "净收入留存率",
        "unit": "%",
        "formula": "(存量期初收入-流失收入-收缩收入+扩展收入)/存量期初收入*100",
